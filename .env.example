# Supabase → Project Settings → Database → Connection string
# App (Vercel): pooler en modo transacción, puerto 6543
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# drizzle-kit (migraciones): conexión directa o pooler en modo sesión, puerto 5432
DIRECT_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: sin clave, la evaluación de respuestas usa reglas por palabras clave
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional: tiempos del demo (segundos)
# NEXT_PUBLIC_ESCALATION_SECONDS=60
# NEXT_PUBLIC_COUNTDOWN_SECONDS=60
# NEXT_PUBLIC_EMERGENCY_NUMBER=911
# NEXT_PUBLIC_HOME_TIMEZONE=America/Argentina/Buenos_Aires
